---
import { getCollection } from 'astro:content';
import { visibleNav, site, isCurrent } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** The home page prints its own name at full size, so the running head omits it. */
  showName?: boolean;
}

const { showName = true } = Astro.props;
const path = Astro.url.pathname;
const publishedNotes = (await getCollection('notes')).filter(
  (entry) => import.meta.env.DEV || !entry.data.draft,
);
const items = visibleNav(publishedNotes.length > 0);
---

<header class="editorial sticky top-0 z-40 border-b border-rule bg-paper">
  <div
    class:list={[
      'col-wide flex flex-wrap items-baseline gap-x-8 gap-y-3 py-4',
      showName ? 'justify-between' : 'justify-start sm:justify-end',
    ]}
  >
    {
      showName && (
        <a
          href="/"
          class="font-display text-lg tracking-tight transition-colors duration-200 hover:text-accent"
        >
          {site.name}
        </a>
      )
    }

    <nav aria-label="Primary" class="flex flex-wrap items-baseline gap-x-5 gap-y-2 sm:gap-x-6">
      {
        items.map((item) => {
          const current = isCurrent(path, item.href);
          return (
            <a
              href={item.href}
              aria-current={current ? 'page' : undefined}
              class:list={[
                'label transition-colors duration-200 hover:text-ink',
                current && 'text-ink underline decoration-accent decoration-1 underline-offset-[0.45em]',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
