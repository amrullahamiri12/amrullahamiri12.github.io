---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');

/** Case study if it's written, otherwise the live product, otherwise nothing to link. */
function destination(entry: CollectionEntry<'work'>) {
  if (entry.data.caseStudy) return { href: `/work/${entry.id}`, external: false };
  if (entry.data.live) return { href: entry.data.live, external: true };
  return null;
}
---

<ol class="mt-8" data-reveal-stagger>
  {
    entries.map((entry, i) => {
      const target = destination(entry);
      const Tag = target ? 'a' : 'div';

      return (
        <li class="border-t border-rule last:border-b">
          <Tag
            {...(target
              ? {
                  href: target.href,
                  ...(target.external ? { rel: 'noopener', target: '_blank' } : {}),
                }
              : {})}
            class:list={['group block py-6 sm:py-7', target && 'cursor-pointer']}
          >
            <div class="flex items-baseline gap-4 sm:gap-6">
              <span class="label shrink-0 pt-1 transition-colors duration-200 group-hover:text-accent">
                {pad(i + 1)}
              </span>

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <h3
                    class:list={[
                      'display text-2xl transition-colors duration-200',
                      target && 'group-hover:text-accent',
                    ]}
                    transition:name={`work-${entry.id}`}
                  >
                    {entry.data.title}
                  </h3>
                  <span class="label shrink-0">{entry.data.period}</span>
                </div>

                <p class="mt-2 max-w-prose text-ink-soft">{entry.data.summary}</p>

                <p class="label mt-3 flex flex-wrap gap-x-4 gap-y-1">
                  <span>{entry.data.stack.join(' · ')}</span>
                  {target && !target.external && <span class="text-accent">Read the study &rarr;</span>}
                  {target?.external && <span class="text-accent">Visit &rarr;</span>}
                  {!target && <span>Case study in progress</span>}
                </p>
              </div>
            </div>
          </Tag>
        </li>
      );
    })
  }
</ol>
