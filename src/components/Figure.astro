---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Break out of the prose column to use the margin as well. */
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={['my-10', wide && 'col-wide']}>
  <Image
    src={src}
    alt={alt}
    widths={[640, 1024, 1440]}
    sizes="(min-width: 64rem) 55rem, 100vw"
    class="w-full border border-rule"
    loading="lazy"
  />
  {caption && <figcaption class="label mt-3">{caption}</figcaption>}
</figure>
