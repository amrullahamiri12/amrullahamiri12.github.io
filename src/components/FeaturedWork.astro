---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary, period, status, cover, coverAlt, metrics } = entry.data;
const lead = metrics?.[0];
---

<article class="col-wide" data-reveal>
  <p class="label">Featured</p>

  <a href={`/work/${entry.id}`} class="group mt-5 block">
    <h2
      class="display text-4xl transition-colors duration-200 group-hover:text-accent"
      transition:name={`work-${entry.id}`}
    >
      {title}
    </h2>
    <p class="label mt-3">{status} · {period}</p>
    <p class="measure mt-5 text-lg text-ink-soft">{summary}</p>

    {
      lead && (
        <p class="mt-8 flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <span class="display text-4xl">{lead.value}</span>
          <span class="label">{lead.label}</span>
        </p>
      )
    }

    {
      cover && (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[720, 1080, 1440]}
          sizes="(min-width: 64rem) 55rem, 100vw"
          class="mt-8 w-full border border-rule"
          loading="eager"
        />
      )
    }

    <p class="label mt-5 text-accent">Read the study &rarr;</p>
  </a>
</article>
