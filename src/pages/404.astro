---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — Amrullah Amiri" description="That page doesn't exist.">
  <section class="editorial pt-24 pb-32">
    <p class="label">Error 404</p>
    <h1 class="display mt-4 text-5xl">Nothing here</h1>
    <span class="rule-draw mt-8" aria-hidden="true"></span>
    <p class="measure mt-6 text-lg text-ink-soft italic">
      That page doesn&rsquo;t exist &mdash; or it did, and I moved it.
    </p>
    <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
      <a class="link" href="/">Front page</a>
      <a class="link" href="/work">Work</a>
      <a class="link" href="/about">About</a>
    </p>
  </section>
</Base>
