---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkIndex from '../components/WorkIndex.astro';
import { site } from '../lib/site';

const work = (await getCollection('work'))
  .filter((entry) => import.meta.env.DEV || !entry.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const notes = (await getCollection('notes'))
  .filter((entry) => import.meta.env.DEV || !entry.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<Base title={`${site.name} — ${site.role}`} showName={false}>
  <section class="editorial pt-20 pb-16 sm:pt-28" data-reveal>
    <h1 class="display text-6xl">{site.name}</h1>
    <p class="measure mt-8 text-2xl text-ink-soft">{site.headline}</p>
    <p class="mt-5 text-lg text-muted italic">{site.tagline}</p>
  </section>

  {/* TODO(amrullah): draft copy from your LinkedIn — rewrite it in your voice. */}
  <section class="editorial pb-24">
    <div class="measure row-1 space-y-5">
      <p>
        I&rsquo;m studying computer science at {site.school}, transferring to
        San&nbsp;Jos&eacute; State in Spring 2027, and heading toward {site.focus}. I came to it
        late and on purpose: before this I spent about a decade doing other work &mdash;
        closing books as an accountant, interpreting Pashto and English for hospitals and
        courts, running accounts for a company in Kabul.
      </p>
      <p>
        That&rsquo;s the part I think is worth something. I have been the person on the
        other end of badly built software, at month-end, with a deadline. It made me
        particular about the difference between a thing that demos and a thing that holds.
      </p>
      <p>
        <a class="link" href="/about">Read the whole chronology &rarr;</a>
      </p>
    </div>

    <aside class="col-side row-1 mt-10 border-t border-rule pt-5 lg:mt-0 lg:border-0 lg:pt-0">
      <h2 class="label">Looking for</h2>
      <p class="mt-3 text-sm text-ink-soft">{site.looking.what}</p>
      <p class="mt-2 text-sm text-muted">{site.looking.where}</p>
      {/* Never render an unanswered placeholder to the public. */}
      {!site.looking.authorization.startsWith('TODO') && (
        <p class="mt-2 text-sm text-muted">{site.looking.authorization}</p>
      )}
      <p class="mt-4">
        <a class="label transition-colors duration-200 hover:text-accent" href={`mailto:${site.email}`}>
          Get in touch &rarr;
        </a>
      </p>
    </aside>
  </section>

  <section class="editorial pb-20">
    <h2 class="label">Selected work</h2>
    <WorkIndex entries={work} />
  </section>

  {
    notes.length > 0 && (
      <section class="editorial pb-8">
        <h2 class="label">Recent notes</h2>
        <ul class="mt-6 space-y-4">
          {notes.map((note) => (
            <li>
              <a class="link text-lg" href={`/notes/${note.id}`}>
                {note.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
