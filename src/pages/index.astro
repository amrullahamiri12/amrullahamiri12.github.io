---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import WorkIndex from '../components/WorkIndex.astro';
import { site } from '../lib/site';

const work = (await getCollection('work'))
  .filter((entry) => import.meta.env.DEV || !entry.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const featured = work.find((entry) => entry.data.cover && entry.data.caseStudy) ?? work[0];
const rest = work.filter((entry) => entry.id !== featured?.id);

const notes = (await getCollection('notes'))
  .filter((entry) => import.meta.env.DEV || !entry.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const [given, ...family] = site.name.split(' ');
---

<Base title={`${site.name} — ${site.role}`} showName={false}>
  <section class="editorial pt-16 pb-12 sm:pt-24" data-reveal>
    <h1 class="display text-6xl">
      <span class="block">{given}</span>
      <span class="block">{family.join(' ')}</span>
    </h1>
    <span class="mt-8 block h-px w-12 bg-accent" aria-hidden="true"></span>
    <p class="measure mt-8 text-2xl text-ink-soft">{site.headline}</p>
    <p class="mt-5 text-lg text-muted italic">{site.tagline}</p>

    <div class="mt-10 max-w-xl border-y border-rule py-5">
      <h2 class="label">Looking for</h2>
      <p class="mt-3 text-ink-soft">{site.looking.what}</p>
      <p class="mt-1 text-sm text-muted">
        {site.looking.where}
        {!site.looking.authorization.startsWith('TODO') && <> · {site.looking.authorization}</>}
      </p>
      <p class="mt-4">
        <a class="label transition-colors duration-200 hover:text-accent" href={`mailto:${site.email}`}>
          Get in touch &rarr;
        </a>
      </p>
    </div>
  </section>

  <section class="editorial pb-20">
    <div class="measure space-y-5">
      <p>
        I&rsquo;m studying computer science at {site.school}, transferring to
        San&nbsp;Jos&eacute; State in Spring 2027, and heading toward {site.focus}. I came to it
        late and on purpose: before this I spent about a decade doing other work &mdash;
        closing books as an accountant, interpreting Pashto and English for hospitals and
        courts, running accounts for a company in Kabul.
      </p>
      <p>
        That&rsquo;s the part I think is worth something. I have been the person on the
        other end of badly built software, at month-end, with a deadline. It made me
        particular about the difference between a thing that demos and a thing that holds. <a class="link" href="/about">The whole chronology &rarr;</a>
      </p>
    </div>
  </section>

  {
    featured && (
      <section class="editorial pb-16">
        <FeaturedWork entry={featured} />
      </section>
    )
  }

  <section class="editorial pb-20">
    <h2 class="label">{featured ? 'Selected work' : 'Work'}</h2>
    <WorkIndex entries={rest.length > 0 ? rest : work} />
  </section>

  {
    notes.length > 0 && (
      <section class="editorial pb-8">
        <h2 class="label">Recent notes</h2>
        <ul class="mt-6 space-y-4">
          {notes.map((note) => (
            <li>
              <a class="link text-lg" href={`/notes/${note.id}`}>
                {note.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
