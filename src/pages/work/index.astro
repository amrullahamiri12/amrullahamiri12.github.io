---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkIndex from '../../components/WorkIndex.astro';

const work = (await getCollection('work'))
  .filter((entry) => import.meta.env.DEV || !entry.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Work — Amrullah Amiri">
  <section class="editorial pt-16 pb-24">
    <h1 class="display text-4xl">Work</h1>
    <p class="measure mt-5 text-lg text-ink-soft italic">
      Four projects. Each one has a decision I can defend.
    </p>
    <WorkIndex entries={work} />
  </section>
</Base>
