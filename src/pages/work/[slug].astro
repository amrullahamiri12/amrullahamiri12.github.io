---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Marginalia from '../../components/Marginalia.astro';
import FolioRail from '../../components/FolioRail.astro';

export const getStaticPaths = (async () => {
  // Drafts are visible while developing but never published.
  // Only projects whose case study is actually written get a page.
  const entries = (await getCollection('work')).filter(
    (entry) => entry.data.caseStudy && (import.meta.env.DEV || !entry.data.draft),
  );
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, role, stack, period, status, repo, live } = entry.data;

// Neighbours for the footer, in the same order the index shows them.
const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((e) => e.id === entry.id);
const previous = all[index - 1];
const next = all[index + 1];

const links = [
  live && { label: 'Visit', href: live },
  repo && { label: 'Source', href: repo },
].filter(Boolean) as { label: string; href: string }[];
---

<Base title={`${title} — Amrullah Amiri`} description={summary}>
  <article>
    <header class="editorial pt-14 pb-10" data-reveal>
      <p class="label">{status} · {period}</p>

      <h1 class="display mt-4 text-5xl" transition:name={`work-${entry.id}`}>
        {title}
      </h1>

      <p class="measure mt-6 text-lg text-ink-soft italic">{summary}</p>

      <dl class="mt-10 grid gap-x-10 gap-y-5 border-t border-rule pt-6 sm:grid-cols-2">
        <div>
          <dt class="label">Role</dt>
          <dd class="mt-1 text-sm">{role}</dd>
        </div>
        <div>
          <dt class="label">Built with</dt>
          <dd class="mt-1 text-sm">{stack.join(' · ')}</dd>
        </div>
      </dl>

      {
        links.length > 0 && (
          <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
            {links.map((link) => (
              <a class="label transition-colors duration-200 hover:text-accent" href={link.href} rel="noopener">
                {link.label} &rarr;
              </a>
            ))}
          </p>
        )
      }
    </header>

    <div class="editorial pb-16">
      <FolioRail />
      <div class="prose-editorial row-1">
        <Content components={{ Marginalia }} />
      </div>
    </div>
  </article>

  {
    (previous || next) && (
      <nav class="editorial border-t border-rule pt-8" aria-label="Other projects">
        <div class="flex flex-wrap justify-between gap-6">
          {previous ? (
            <a class="group" href={`/work/${previous.id}`}>
              <span class="label block">Previous</span>
              <span class="font-display text-xl transition-colors duration-200 group-hover:text-accent">
                {previous.data.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="group text-right" href={`/work/${next.id}`}>
              <span class="label block">Next</span>
              <span class="font-display text-xl transition-colors duration-200 group-hover:text-accent">
                {next.data.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )
  }
</Base>
